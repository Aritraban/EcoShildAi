# ------------------------------------------------------------------
# EcoShield AI - environment configuration
# Copy to `.env` and adjust. NEVER commit a real `.env` with secrets.
# ------------------------------------------------------------------

# development | staging | production
ECOSHIELD_ENVIRONMENT=development
ECOSHIELD_DEBUG=true

# Database (SQLite by default so the app runs with zero setup).
# PostgreSQL example:
#   ECOSHIELD_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/ecoshield
# MySQL example:
#   ECOSHIELD_DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/ecoshield
ECOSHIELD_DATABASE_URL=sqlite:///./ecoshield.db

# SECURITY: set a long random value in production (>= 32 chars).
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ECOSHIELD_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ECOSHIELD_JWT_ALGORITHM=HS256
ECOSHIELD_ACCESS_TOKEN_EXPIRE_MINUTES=30
ECOSHIELD_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies / CORS. Set COOKIE_SECURE=true when serving over HTTPS.
ECOSHIELD_COOKIE_SECURE=false
ECOSHIELD_COOKIE_SAMESITE=lax
ECOSHIELD_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500

# Account protection
ECOSHIELD_MAX_FAILED_LOGINS=5
ECOSHIELD_LOCKOUT_MINUTES=15

# Rate limiting
ECOSHIELD_RATE_LIMIT_DEFAULT=120
ECOSHIELD_RATE_LIMIT_WINDOW_SECONDS=60
ECOSHIELD_RATE_LIMIT_AUTH=10

# AI
ECOSHIELD_ANOMALY_CONTAMINATION=0.1
ECOSHIELD_LLM_ENABLED=false
ECOSHIELD_OPENAI_API_KEY=
ECOSHIELD_OPENAI_MODEL=gpt-4o-mini

# Initial staff accounts (created on first run if they do not exist).
ECOSHIELD_ADMIN_EMAIL=admin@ecoshield.app
ECOSHIELD_ADMIN_PASSWORD=EcoShield#Admin1
ECOSHIELD_SECURITY_EMAIL=security@ecoshield.app
ECOSHIELD_SECURITY_PASSWORD=EcoShield#Sec1
